---
import { Discord, GitHub, Heart, Rss } from '../icons';
import pkg from '../../package.json';
import { deps, hostedBy } from '../data/footer.js';

const discordCode = import.meta.env.PUBLIC_DISCORD_INVITE ?? '';
const version = `v${pkg.version}`;
---

<footer class="py-12 px-6 border-t bg-surface border-border">
  <div class="max-w-5xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-[1fr_auto_1fr] items-center gap-8">
      <!-- Left: license + attribution -->
      <div class="space-y-3">
        <p class="text-sm text-muted">
          odio is
          <a
            href="https://github.com/b0bbywan/odios"
            target="_blank"
            rel="noopener noreferrer"
            class="underline underline-offset-2 transition-colors text-muted hover:text-leaf"
          > free and open source</a>, each component under its own license.
        </p>
        <p class="text-sm text-subtle">
          Built on the shoulders of:
          {deps.map((dep, i) => (
            <>
              <a
                href={dep.url}
                target="_blank"
                rel="noopener noreferrer"
                class="transition-colors underline underline-offset-2 text-subtle hover:text-muted"
              >{dep.name}</a>{i < deps.length - 1 ? ', ' : '.'}
            </>
          ))}
        </p>
        <p class="text-sm text-subtle">
          Hosted by:
          {hostedBy.map((svc, i) => (
            <>
              <a
                href={svc.url}
                target="_blank"
                rel="noopener noreferrer"
                title={svc.label}
                class="transition-colors underline underline-offset-2 text-subtle hover:text-muted"
              >{svc.name}</a>{i < hostedBy.length - 1 ? ', ' : '.'}
            </>
          ))}
        </p>
      </div>

      <!-- Center: logo easter egg -->
      <div class="group flex flex-col items-center justify-center">
        <img src="/logo.png" alt="odio" width="96" height="96" loading="lazy" decoding="async" class="opacity-60 group-hover:opacity-100 transition-opacity" />
        <span class="mt-2 text-xs italic opacity-0 group-hover:opacity-100 transition-opacity duration-700 delay-700 text-amber">the most sustainable device is the one already manufactured</span>
      </div>

      <!-- Right: links -->
      <div class="flex flex-col items-end gap-2">
        <a
          href="https://github.com/b0bbywan"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 text-sm transition-colors text-subtle hover:text-muted"
          aria-label="b0bbywan on GitHub"
        >
          <GitHub width="16" height="16" aria-hidden="true" />
          b0bbywan
        </a>
        <a
          href="#"
          data-d={discordCode}
          class="js-discord flex items-center gap-2 text-sm transition-colors cursor-pointer text-subtle hover:text-muted focus:text-muted"
          aria-label="odio Discord"
        >
          <Discord width="16" height="16" aria-hidden="true" />
          Discord
        </a>
        <a
          href="/releases.xml"
          class="flex items-center gap-2 text-sm transition-colors text-subtle hover:text-muted"
          aria-label="odio releases feed (Atom)"
        >
          <Rss width="16" height="16" aria-hidden="true" />
          Releases feed
        </a>
        <a
          href="https://github.com/sponsors/b0bbywan"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-1.5 text-sm transition-colors text-subtle hover:text-amber"
        >
          <Heart width="14" height="14" aria-hidden="true" />
          Support odio development
        </a>
      </div>
    </div>

    <div class="mt-8 pt-6 border-t flex flex-col items-center border-border">
      <p class="text-xs text-center text-subtle">
        odio·love — Your Pi. Your music. No expiry date.
      </p>
      <nav class="mt-3 flex flex-wrap items-center justify-center gap-x-2.5 gap-y-1 text-xs" aria-label="Legal">
        <a href="/legal-notice" class="transition-colors text-subtle hover:text-leaf">Legal notice</a>
        <span aria-hidden="true" class="text-subtle">·</span>
        <a href="/privacy" class="transition-colors text-subtle hover:text-leaf">Privacy</a>
        <span aria-hidden="true" class="text-subtle">·</span>
        <a href="/terms" class="transition-colors text-subtle hover:text-leaf">Terms</a>
      </nav>
      <p class="text-xs text-center font-mono mt-3 text-subtle">{version}</p>
    </div>
  </div>
</footer>

<script>
  /**
   * The invite URL is assembled client-side so it is not a harvestable string in
   * the static HTML. It used to live in an inline `onclick`, which the site's CSP
   * blocks (no 'unsafe-hashes'), leaving the link dead — and a plain href is
   * better anyway: it works with the keyboard, middle-click and "open in new tab".
   */
  document.querySelectorAll<HTMLAnchorElement>('a.js-discord').forEach((a) => {
    const code = a.dataset.d;
    if (!code) return;
    // .join() survives minification; a `'disc' + 'ord'` concatenation gets folded
    // straight back into a literal, which is what the split was there to avoid.
    a.href = `https://${['disc', 'ord', '.gg'].join('')}/${code}`;
    a.target = '_blank';
    a.rel = 'noopener noreferrer';
    a.removeAttribute('data-d');
  });
</script>
