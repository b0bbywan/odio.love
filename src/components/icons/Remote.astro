---
// Lucide has no remote control icon: this one is drawn on its grid and stroke.
const { width = 24, height = 24, ...rest } = Astro.props;
---
<svg
  {width}
  {height}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  {...rest}
>
  <rect x="7" y="2" width="10" height="20" rx="3" />
  <circle cx="12" cy="8" r="2.5" />
  <path d="M10 14h.01M14 14h.01M10 18h.01M14 18h.01" />
</svg>
